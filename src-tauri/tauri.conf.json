{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eMerge",
  "mainBinaryName": "eMerge",
  "version": "1.0.0",
  "identifier": "com.example.emerge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "eMerge",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/portable-git": "resources/portable-git",
      "../resources/shared-sheet-rules.json": "resources/shared-sheet-rules.json",
      "../manual_test_data": "manual_test_data"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
